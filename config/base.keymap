#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        lbh: lbh {
            compatible = "zmk,behavior-hold-tap";
            label = "LBH";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <500>;
        };

        hlt: hlt {
            compatible = "zmk,behavior-hold-tap";
            label = "HLT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        commaQ: commaQ {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA_QM";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(MINUS)>;
        };

        dotExc: dotExc {
            compatible = "zmk,behavior-tap-dance";
            label = "DOT2EXC";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp EXCL>;
        };

        //single and double quotes

        sdquotes: sdquotes {
            compatible = "zmk,behavior-tap-dance";
            label = "SDQUOTES";
            #binding-cells = <0>;
            bindings = <&kp BSLH>, <&kp LS(N2)>;
        };

        atEsc: atEsc {
            compatible = "zmk,behavior-tap-dance";
            label = "ATESC";
            #binding-cells = <0>;
            bindings = <&mt LCTRL ESC>, <&kp RA(N2)>;
        };

        Idollar: Idollar {
            compatible = "zmk,behavior-tap-dance";
            label = "IDOLLAR";
            #binding-cells = <0>;
            bindings = <&kp I>, <&kp RA(N4)>;
        };

        multileft: multileft {
            compatible = "zmk,behavior-tap-dance";
            label = "MULTILEFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&kp HOME>;
        };
        layertoggler: layertoggler {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYERTOGGLER";
            #binding-cells = <0>;
            bindings = <&tog 4>, <&tog 1>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&kp C_MUTE    &kp H  &kp P  &kp B       &kp G      &kp D                                                               &kp SEMI       &kp SQT       &kp U        &kp M  &kp J     &layertoggler
&kp ESC       &kp L  &kp N  &kp T       &kp S      &kp F                                                               &dotExc         &kp A         &kp E        &kp R  &Idollar  &kp Y
&kp TAB       &kp Z  &kp V  &kp K       &kp C      &kp X     &mt LALT LEFT  &hlt 2 UP         &hlt 2 DOWN  &hlt 1 RIGHT  &commaQ        &kp O         &kp LBKT     &kp W  &kp Q     &sdquotes
              &mt LSHFT HOME  &kp LCTRL  &sl 1  &kp LGUI  &hlt 3 LG(LS(GRAVE))           &kp BACKSPACE     &kp RET  &kp SPACE  &mt LCTRL DEL  &mt RALT END
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp RIGHT LEFT>;
        };

        NUMBERS {
            bindings = <
&trans      &kp N1      &kp N2      &kp N3      &kp N4      &kp N5                                      &kp N6      &kp N7  &kp N8  &kp N9  &kp N0           &trans
&trans      &kp LG(F1)  &kp LG(F2)  &kp LG(F3)  &kp LG(F4)  &kp LG(F5)                                  &kp LS(N0)  &kp N4  &kp N5  &kp N6  &kp MINUS        &kp SLASH
&trans      &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)  &trans  &trans  &trans  &trans  &kp N0      &kp N1  &kp N2  &kp N3  &kp KP_MULTIPLY  &kp KP_DIVIDE
                                    &trans      &trans      &trans      &trans  &trans  &trans  &trans  &trans      &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp RIGHT LEFT>;
        };

        CODING {
            bindings = <
&trans  &kp HASH      &kp RA(E)      &kp RA(NUMBER_3)  &kp RA(N4)     &kp PERCENT                                               &kp LS(NUMBER_6)          &kp LS(NUMBER_2)  &kp BSLH    &kp LS(FSLH)  &kp LS(N0)       &trans
&trans  &kp RBKT      &kp LS(MINUS)  &kp EXCL          &kp RA(N2)     &kp LS(DOT)                                               &kp NON_US_BACKSLASH      &kp LS(N8)        &kp RA(N7)  &kp RA(N8)    &kp MINUS        &kp FSLH
&trans  &kp RA(RBKT)  &kp LS(N4)     &kp LS(N7)        &kp RA(MINUS)  &kp RA(NON_US_BACKSLASH)  &trans  &trans  &trans  &trans  &kp LS(NON_US_BACKSLASH)  &kp LS(N9)        &kp RA(N0)  &kp RA(N9)    &kp KP_MULTIPLY  &kp KP_DIVIDE
                                     &trans            &trans         &trans                    &trans  &trans  &trans  &trans  &trans                    &trans            &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp RIGHT LEFT>;
        };

        NAVI {
            bindings = <
&trans       &kp F1  &kp F2   &kp F3   &kp F4   &bt BT_CLR                                  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_BRI_INC  &kp C_BRI_DEC  &trans
&sys_reset   &kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN                                       &kp HOME    &kp LEFT  &kp UP      &kp RIGHT      &kp END        &sys_reset
&bootloader  &kp F9  &kp F10  &kp F11  &kp F12  &none       &trans  &trans  &trans  &trans  &kp INS     &kp LEFT  &kp DOWN    &kp RIGHT      &kp END        &bootloader
                              &trans   &trans   &trans      &trans  &trans  &trans  &trans  &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp RIGHT LEFT>;
        };
        QWERTY {
            bindings = <
&trans        &kp Q  &kp W  &kp E  &kp R  &kp T                                                            &kp Y  &kp U  &kp I  &kp O  &kp P    &trans
&trans        &kp A  &kp S  &kp D  &kp F  &kp G                                                            &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp LBKT
&trans        &kp Z  &kp X  &kp C  &kp V  &kp B            &trans  &trans  &trans  &trans                  &kp N  &kp M  &commaQ &dotExc &kp SLASH  &kp SQT
                              &trans   &trans   &trans      &trans  &trans  &trans  &trans     &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp RIGHT LEFT>;
        };
    };
};
